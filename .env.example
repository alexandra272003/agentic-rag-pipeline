# Day 31: generation only. Embeddings (Day 29) run locally and need no key.
# Groq's chat endpoint is real (unlike their embeddings endpoint, which
# does not exist, despite some third-party client libraries implying
# otherwise -- confirmed the hard way while building this project).
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Day 37: structured output. json_schema | json_mode | none
LLM_STRUCTURED_METHOD=json_schema
# Re-asks when the model's reply breaks the schema (separate from LLM_MAX_RETRIES,
# which retries transport failures). Worst case calls = (1+this) * (1+LLM_MAX_RETRIES).
LLM_VALIDATION_RETRIES=2

# Week 7: authentication. Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=production (or anything but development) the app refuses to start on the default secret.
ENVIRONMENT=development
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-real-use
JWT_TTL_MINUTES=60
